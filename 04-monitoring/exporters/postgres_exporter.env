# =============================================================================
# POSTGRES EXPORTER — Variables d'environnement
# Fichier : 04-monitoring/exporters/postgres_exporter.env
# Déployer sur chaque nœud pg-node-1/2/3 :
#   /etc/postgres_exporter/postgres_exporter.env
#   Référencé par postgres_exporter.service (EnvironmentFile=)
#
# RÔLE UTILISÉ : aciertech_ro (créé en V007, SELECT sur iot_clean + vues dba_schema)
#   Permissions : aciertech_ro = SELECT iot_clean.*, dba_schema.v_*, pg_monitor
#   NE PAS utiliser postgres ou aciertech_app pour l'exporter (principe moindre privilège)
#
# CONNEXION : via socket Unix locale (pas de réseau, évite de passer par pgBouncer)
#   → pas de problème avec pool_mode=transaction pour les métriques
# =============================================================================

# ---------------------------------------------------------------------------
# DSN de connexion — rôle aciertech_ro (lecture seule)
# Connexion directe via socket Unix PostgreSQL 16 sur le nœud local
# NON routé par pgBouncer (port 6432) — connexion directe port 5432
# ---------------------------------------------------------------------------
DATA_SOURCE_NAME="user=aciertech_ro password=CHANGE_ME_ACIERTECH_RO dbname=aciertech_db host=/var/run/postgresql port=5432 sslmode=disable application_name=postgres_exporter"

# ---------------------------------------------------------------------------
# Chemin vers le fichier de requêtes custom (queries.yaml)
# Contient les requêtes sur les vues dba_schema : v_data_quality_dashboard,
# v_replication_status, v_session_activity, v_silent_sensors, backup_history
# ---------------------------------------------------------------------------
PG_EXPORTER_EXTEND_QUERY_PATH="/etc/postgres_exporter/queries.yaml"

# ---------------------------------------------------------------------------
# Port d'écoute postgres_exporter
# Référencé dans prometheus.yml (scrape job postgres_exporter_node*)
# ---------------------------------------------------------------------------
PG_EXPORTER_WEB_LISTEN_ADDRESS=":9187"
PG_EXPORTER_WEB_TELEMETRY_PATH="/metrics"

# ---------------------------------------------------------------------------
# Métriques PostgreSQL natives à activer
# ---------------------------------------------------------------------------
# Inclure les stats pg_stat_bgwriter (pour VACUUM/checkpoint monitoring)
PG_EXPORTER_INCLUDE_DATABASES="aciertech_db"

# Exclure les bases système (réduire le bruit dans Grafana)
# PG_EXPORTER_EXCLUDE_DATABASES="template0,template1,postgres"

# ---------------------------------------------------------------------------
# Métriques désactivées (inutiles ici ou couvertes par queries.yaml)
# ---------------------------------------------------------------------------
# Désactiver la collecte des métriques de taille de base (coûteux si données volumineuses)
# Activer si besoin : aciertech_db_size dans les dashboards
PG_EXPORTER_DISABLE_SETTINGS_METRICS="false"
PG_EXPORTER_DISABLE_DEFAULT_METRICS="false"

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
PG_EXPORTER_LOG_LEVEL="warn"
PG_EXPORTER_LOG_FORMAT="logger:stderr"

# ---------------------------------------------------------------------------
# Auto-découverte (Patroni fait varier le rôle primaire/standby)
# L'exporter se reconnecte automatiquement après un failover
# ---------------------------------------------------------------------------
PG_EXPORTER_AUTO_DISCOVER_DATABASES="false"

# ---------------------------------------------------------------------------
# Timeout de collecte — évite de bloquer Prometheus si PG est lent
# Compatible synchronous_commit=on (pas de délai d'écriture, mais requêtes peuvent
# être lentes si verrous actifs — le timeout protège le scrape)
# ---------------------------------------------------------------------------
PG_EXPORTER_SCRAPE_TIMEOUT="9500ms"
# Légèrement inférieur à scrape_timeout=10s de prometheus.yml

# ---------------------------------------------------------------------------
# NOTES :
# 1. Le mot de passe aciertech_ro doit correspondre à celui défini dans V007.
# 2. Sur chaque nœud, après un failover Patroni, le socket Unix est toujours
#    disponible (Patroni redémarre PG sur le même socket).
# 3. aciertech_ro a besoin du rôle pg_monitor (PG16) pour accéder à
#    pg_stat_replication, pg_stat_activity avec plus de détails.
#    → GRANT pg_monitor TO aciertech_ro; (à ajouter dans V007 si pas déjà fait)
# ---------------------------------------------------------------------------