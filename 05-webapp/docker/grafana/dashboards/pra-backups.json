              "stanza": "Stanza",
              "started_at": "D\u00e9marr\u00e9 \u00e0 (UTC)",
              "completed_at": "Termin\u00e9 \u00e0 (UTC)",
              "status": "Statut",
              "size_bytes": "Taille",
              "backup_label": "Label"
            },
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "instance": true,
              "job": true
            }
          }
        }
      ],
      "type": "table"
