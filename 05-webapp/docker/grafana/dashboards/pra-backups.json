      "title": "Historique r\u00e9cent backups (dba_schema.backup_history \u2014 type: full/diff/pitr/test_restore)",
      "description": "Colonnes ajout\u00e9es : size_bytes, pitr_target, repo_path, error_detail (ALTER TABLE appliqu\u00e9 avant premier backup)",
      "targets": [
        {
          "expr": "aciertech_backup_history_info{job=~\"postgres_exporter_node.*\"}",
          "format": "table",
          "legendFormat": "",
          "refId": "A",
