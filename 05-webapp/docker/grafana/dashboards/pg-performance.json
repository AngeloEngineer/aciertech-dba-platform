      "title": "Transactions / seconde (commits + rollbacks) \u2014 aciertech_db",
      "targets": [
        {
          "expr": "rate(pg_stat_database_xact_commit{datname=\"aciertech_db\",job=\"postgres_exporter_node1\"}[5m])",
          "legendFormat": "Commits/s (node1)",
          "refId": "A"
        },
        {
          "expr": "rate(pg_stat_database_xact_rollback{datname=\"aciertech_db\",job=\"postgres_exporter_node1\"}[5m])",
          "legendFormat": "Rollbacks/s (node1)",
          "refId": "B"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-aciertech"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
