      "targets": [
        {
          "expr": "pg_stat_user_tables_n_dead_tup{schemaname=\"iot_raw\",relname=\"sensor_readings\",job=~\"postgres_exporter_node.*\"}",
          "legendFormat": "iot_raw.sensor_readings dead tuples {{node}}",
          "refId": "A"
        },
        {
          "expr": "pg_stat_user_tables_n_dead_tup{schemaname=\"iot_clean\",relname=\"sensor_readings\",job=~\"postgres_exporter_node.*\"}",
          "legendFormat": "iot_clean.sensor_readings dead tuples {{node}}",
