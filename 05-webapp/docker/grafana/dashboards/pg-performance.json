{
  "description": "Performances PostgreSQL 16 \u2014 Cache hit, TPS, locks, sessions actives \u2014 aciertech_db",
  "editable": false,
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 100,
      "title": "Statistiques Globales aciertech_db",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-aciertech"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.9
              },
              {
                "color": "green",
                "value": 0.95
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "id": 1,
      "options": {
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "title": "Cache Hit Ratio \u2014 aciertech_db",
      "targets": [
        {
          "expr": "pg_stat_database_blks_hit{datname=\"aciertech_db\",job=~\"postgres_exporter_node.*\"} / (pg_stat_database_blks_hit{datname=\"aciertech_db\",job=~\"postgres_exporter_node.*\"} + pg_stat_database_blks_read{datname=\"aciertech_db\",job=~\"postgres_exporter_node.*\"} + 1)",
          "legendFormat": "Cache hit {{node}}",
          "refId": "A",
          "instant": true
        }
      ],
      "type": "gauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-aciertech"
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 150
              },
              {
                "color": "red",
                "value": 180
              }
            ]
          }
        }
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "id": 2,
      "options": {
        "colorMode": "background",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "title": "Connexions actives (max=200)",
      "targets": [
        {
          "expr": "pg_stat_database_numbackends{datname=\"aciertech_db\",job=~\"postgres_exporter_node.*\"}",
          "legendFormat": "Connexions {{node}}",
          "refId": "A",
          "instant": true
        }
      ],
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-aciertech"
      },
