      "targets": [
        {
          "expr": "rate(pg_stat_database_blks_hit{datname=\"aciertech_db\",job=\"postgres_exporter_node1\"}[5m])",
          "legendFormat": "Blocs depuis cache/s",
          "refId": "A"
        },
        {
          "expr": "rate(pg_stat_database_blks_read{datname=\"aciertech_db\",job=\"postgres_exporter_node1\"}[5m])",
          "legendFormat": "Lectures disque/s",
          "refId": "B"
        }
      ],
      "type": "timeseries"
    },
