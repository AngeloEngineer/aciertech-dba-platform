# =============================================================================
# ENVIRONMENT — AcierTech DBA Console
# Copier vers .env et adapter les valeurs à votre environnement.
# =============================================================================

# ── Application ──────────────────────────────────
APP_ENV=development
DEBUG=true

# ── PostgreSQL 16 — via HAProxy ──────────────────
PG_HAPROXY_HOST=localhost
PG_PASSWORD_RO=changeme
PG_PASSWORD_ADMIN=changeme

# ── Patroni API (3 nœuds) ────────────────────────
PG_NODE1_HOST=localhost
PG_NODE2_HOST=localhost
PG_NODE3_HOST=localhost

# ── Grafana ───────────────────────────────────────
GRAFANA_HOST=localhost

# ── Prometheus ────────────────────────────────────
PROMETHEUS_HOST=localhost

# ── HAProxy stats ─────────────────────────────────
HAPROXY_STATS_HOST=localhost
HAPROXY_STATS_PASSWORD=admin
