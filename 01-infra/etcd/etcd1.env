
# =============================================================================
# AcierTech Industries — etcd Nœud 1 (etcd-1)
# INF1620 — Cluster PostgreSQL Haute Disponibilité
# Hébergé sur : pg-node-1 / 192.168.1.11
# =============================================================================
 
# --- Identité du nœud ---
ETCD_NAME=etcd-1
ETCD_DATA_DIR=/var/lib/etcd/aciertech
 
# --- Écoute interne (peer-to-peer entre membres etcd) ---
ETCD_LISTEN_PEER_URLS=http://192.168.1.11:2380
ETCD_LISTEN_CLIENT_URLS=http://192.168.1.11:2379,http://127.0.0.1:2379
 
# --- Adresses annoncées aux autres membres ---
ETCD_INITIAL_ADVERTISE_PEER_URLS=http://192.168.1.11:2380
ETCD_ADVERTISE_CLIENT_URLS=http://192.168.1.11:2379
 
# --- Bootstrap du cluster (phase initiale uniquement) ---
ETCD_INITIAL_CLUSTER_TOKEN=aciertech-etcd-cluster
ETCD_INITIAL_CLUSTER_STATE=new
ETCD_INITIAL_CLUSTER=etcd-1=http://192.168.1.11:2380,etcd-2=http://192.168.1.12:2380,etcd-3=http://192.168.1.13:2380
 
# --- Timeouts & heartbeat (adapter au réseau local) ---
# heartbeat-interval en ms : délai entre les battements de cœur leader→followers
ETCD_HEARTBEAT_INTERVAL=500
# election-timeout en ms : délai avant déclenchement d'une élection leader
# Recommandation : 10x heartbeat-interval minimum
ETCD_ELECTION_TIMEOUT=5000
 
# --- Limites & sécurité ---
# Quota max de la base BoltDB (espace disque etcd, 8 GiB max en prod)
ETCD_QUOTA_BACKEND_BYTES=2147483648
 
# Nettoyage automatique des révisions (compaction toutes les 1000 révisions)
ETCD_AUTO_COMPACTION_MODE=revision
ETCD_AUTO_COMPACTION_RETENTION=1000
 
# --- Logs ---
ETCD_LOG_LEVEL=info
ETCD_LOG_OUTPUTS=stderr
 
# --- Métriques (Prometheus scrape via port 2381) ---
ETCD_LISTEN_METRICS_URLS=http://0.0.0.0:2381
 
# =============================================================================
# NOTE OPÉRATIONNELLE :
# Après le premier démarrage réussi du cluster (état "new"), commenter ou
# retirer la ligne ETCD_INITIAL_CLUSTER_STATE=new pour éviter de réinitialiser
# le cluster lors d'un redémarrage de service.
# ============================================================================